# RV Files deployment reference (no credentials).
# Public HTTP port exposed by the Docker image; local Compose maps 3001 to 3000.
PORT=3000

# Use true behind Railway's reverse proxy so rate limits and access events use
# the forwarded client IP. Local docker-compose.local.yml explicitly uses false.
TRUST_PROXY=true
# Hops the API trusts: Caddy inside the container (1) + cloudflared tunnel (1) = 2
TRUST_PROXY_HOPS=2

# This file documents deployment settings; Compose does not pass its .env values
# into containers unless environment/env_file is configured. The stock image's
# Caddy listener is fixed at 3000, its frontend runs at 3333, and its backend
# defaults to 8080. Configure Railway's public target port as 3000; do not inject
# PORT=3000 into the stock container: Caddy also uses PORT for its frontend
# upstream and the backend uses it as a fallback. Leave runtime PORT unset.
# If setting the backend listener explicitly, use BACKEND_PORT=8080.
# Persist application data with a volume mounted at /opt/app/backend/data.
